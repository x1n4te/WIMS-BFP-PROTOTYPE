# Documentation only. The real .env is generated by setup-secrets.ps1 - never copy this file.
WIMS_HOST=wims.bfp.lan
WIMS_SERVER_IP=192.168.1.50
POSTGRES_PASSWORD=<generated>
KC_DB_PASSWORD=<generated>
WIMS_APP_DB_PASSWORD=<generated>
KEYCLOAK_ADMIN=kcadmin
KEYCLOAK_ADMIN_PASSWORD=<generated>
# base64 of 32 random bytes. LOSING THIS KEY MAKES ENCRYPTED PII AND BACKUPS UNREADABLE.
WIMS_MASTER_KEY=<generated>
WIMS_KEYCLOAK_EVENT_SECRET=<generated>
BOOTSTRAP_ADMIN_USERNAME=<prompted>
BOOTSTRAP_ADMIN_EMAIL=<prompted>
BOOTSTRAP_ADMIN_PASSWORD=<prompted; temporary, forced change at first login>
# Optional SMTP (leave empty to run without email)
SMTP_HOST=
SMTP_PORT=587
SMTP_FROM=
SMTP_USER=
SMTP_PASSWORD=
SMTP_STARTTLS=true
SMTP_AUTH=true
SMTP_SSL=false
SMTP_FROM_DISPLAY=WIMS-BFP
SMTP_REPLYTO=
SMTP_REPLYTO_DISPLAY=WIMS-BFP No Reply
